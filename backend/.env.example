# Salin ke .env di server. JANGAN commit .env yang sudah terisi.

# Port internal backend. Peta port yang sudah dipakai di server aaPanel
# (per catatan internal-performence-aapanel, diverifikasi 2026-07-20 via
# `netstat -tlnp`): 3900=elio-absensi-backend, 3901=dailychecklist-backend,
# 3902=cashflow-postgrest (docker-proxy), 3903=internal-performence-backend.
# 3904 KEMUNGKINAN BESAR bebas tapi WAJIB diverifikasi ulang live
# (`netstat -tlnp` + `pm2 list`) sebelum dipakai — jangan percaya catatan ini
# begitu saja, bisa sudah berubah.
PORT=3904

# MySQL — database `sql_hpp_eliodigihub_my_id` sudah dibuat lewat aaPanel
# Database Manager. Format: mysql://user:password@127.0.0.1:3306/sql_hpp_eliodigihub_my_id
DATABASE_URL=

# openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Same-origin di produksi (frontend & API di domain yang sama) — kosongkan
# atau isi domain spesifik kalau perlu diakses dari origin lain.
CORS_ORIGIN=*

# Hash bcrypt dari PIN 4 digit bersama. Isi via `npm run set-pin` (interaktif
# di server, JANGAN ketik PIN asli di chat).
HPP_PIN_HASH=

# --- Baca lintas-app: harga_acuan_material (lihat src/lib/hargaAcuanClient.ts) ---
# FASE 1 (sekarang): connection string READ-ONLY ke project Supabase Elio
# Cashier (gwdtovpflrkkuvllexrv), pakai role baru yang HANYA di-GRANT SELECT
# ke tabel harga_acuan_material (bukan akses skema penuh). Pakai POOLER /
# transaction-mode connection string (port 6543 di Supabase), BUKAN direct
# connection (port 5432) — project itu masih melayani trafik produksi Vercel
# yang asli, jangan rebutan slot koneksi direct dengannya.
# Ambil dari: Supabase Dashboard project Elio Cashier -> Connect -> Transaction pooler.
# FASE 2 (nanti, setelah Cashflow live produksi sungguhan): ganti ke
# connection string database elio_cashflow di server sendiri. Cukup ganti
# nilai ini, tidak perlu ubah kode (lihat hargaAcuanClient.ts).
HARGA_ACUAN_DATABASE_URL=
